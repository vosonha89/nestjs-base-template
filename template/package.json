{
  "name": "nestjs-api-template",
  "version": "1.0.0",
  "description": "Production-ready NestJS N-layer API template with JWT auth, TypeORM migrations, Swagger and a unified response envelope",
  "author": "vosonha89",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^24.22.3 || >=26.13.1",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./test/vitest-e2e.config.ts",
    "typeorm": "ts-node -T -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d src/data/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/data/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/data/data-source.ts",
    "seed": "ts-node -T -r tsconfig-paths/register src/data/seed/run-seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.2",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-express": "^12.6.2",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.6.2",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.2",
    "@vitest/coverage-v8": "^5.1.2"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1",
    "type-fest": "^4.41.0",
    "ansi-styles": "^5.2.0",
    "escape-string-regexp": "^4.0.0",
    "which": "^7.0.0",
    "emoji-regex": "^10.6.0",
    "diff": "^9.0.0",
    "@tsconfig/node12": "^12.1.9",
    "@tsconfig/node14": "^14.1.10",
    "@tsconfig/node16": "^16.1.10",
    "write-file-atomic": "^8.0.0",
    "json-parse-even-better-errors": "^6.0.0",
    "@sindresorhus/is": "^8.1.0",
    "dotenv-expand": "^1000.0.0",
    "@keyv/bigmap": "^6.1.0",
    "postgres-interval": "^4.1.0"
  }
}
