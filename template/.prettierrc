{
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 120,
	"singleQuote": true,
	"semi": true,
	"trailingComma": "none",
	"arrowParens": "always",
	"endOfLine": "lf",
	"bracketSpacing": true,
	"overrides": [
		{
			"files": ["*.json", "*.jsonc", "*.md", "*.yml", "*.yaml"],
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		}
	]
}