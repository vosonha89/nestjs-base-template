# ─────────────────────────────────────────────────────────────────────────────
# NestJS API Template — environment template
#
# Usage:
#   cp .env.example env/.env.development      # local development
#   cp .env.example env/.env.uat              # uat
#   cp .env.example env/.env.production       # production
#
# The file actually loaded is `env/.env.${NODE_ENV}` — see src/app.module.ts.
# Files under env/.env.* are git-ignored. Never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=nestjs-api-template
APP_PORT=3001
APP_VERSION=1.0.0
API_PREFIX=api
API_DEFAULT_VERSION=1

# ── Swagger ──────────────────────────────────────────────────────────────────
# Set to false in production so the schema is not publicly exposed.
SWAGGER_ENABLED=true
SWAGGER_PATH=api/doc

# ── Database ─────────────────────────────────────────────────────────────────
# Option A — local docker-compose (recommended for a fresh clone):
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=nestjs_api
DB_SSL=false
DB_LOGGING=false

# Option B — managed Postgres (Neon / Supabase / RDS / Cloud SQL…):
# DB_HOST=your-host.example.com
# DB_PORT=5432
# DB_USERNAME=your-user
# DB_PASSWORD=your-password
# DB_DATABASE=your-database
# DB_SSL=true
# DB_LOGGING=false
#
# Validate the server certificate chain. Keep `true` whenever possible.
# Only set to `false` for a provider that serves an incomplete chain.
DB_SSL_REJECT_UNAUTHORIZED=true

# ── JWT ──────────────────────────────────────────────────────────────────────
# REQUIRED. Minimum 32 characters, the app refuses to boot otherwise.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-this-must-be-at-least-32-characters-long
JWT_EXPIRES_IN=1d

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Comma separated list. Use `*` to allow every origin (development only).
CORS_ORIGINS=http://localhost:3000
# Rate limit window, in SECONDS. The module converts to the milliseconds that
# @nestjs/throttler expects, so 60 here means "60 seconds", not "60 ms".
THROTTLE_TTL=60
# Maximum requests per client inside that window.
THROTTLE_LIMIT=60